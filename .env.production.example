# Ambiente de PRODUCCIÓN. Estas variables las inyecta el proveedor (Railway),
# no van escritas en el código ni en el repositorio.
NODE_ENV=production
PGHOST=<host-de-la-base-gestionada>
PGUSER=<usuario>
PGPASSWORD=<contraseña-larga-y-aleatoria>
PGDATABASE=ncfield_db
PGPORT=5432
JWT_SECRET=<secreto-de-64-caracteres-distinto-al-de-desarrollo>
PORT=3000
